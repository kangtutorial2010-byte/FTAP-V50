      end
   end
end)

-- ==================================================
-- LOGIKA TOOL GRAB PLAYER
-- ==================================================
local function GiveGrabTool()
   if not LocalPlayer.Backpack then return end

   local OldTool = LocalPlayer.Backpack:FindFirstChild("Grab Player") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Grab Player"))
   if OldTool then OldTool:Destroy() end

   local Tool = Instance.new("Tool")
   Tool.Name = "Grab Player"
   Tool.RequiresHandle = false
   Tool.CanBeDropped = false

   local Cooldown = false

   local function SetTransparency(char, val)
      for _, p in pairs(char:GetDescendants()) do
         if p:IsA("BasePart") or p:IsA("Decal") then
            p.Transparency = val
         end
      end
   end

   local function CreateDeadHealthbar(head, name)
      local bb = Instance.new("BillboardGui")
      bb.Name = "RobloxDeadHealthbar"
      bb.Adornee = head
      bb.Size = UDim2.new(4, 0, 1.2, 0)
      bb.StudsOffset = Vector3.new(0, 2, 0)
      bb.AlwaysOnTop = true

      local nl = Instance.new("TextLabel")
      nl.Parent = bb
      nl.Size = UDim2.new(1, 0, 0.4, 0)
      nl.BackgroundTransparency = 1
      nl.Text = name
      nl.TextColor3 = Color3.fromRGB(255, 255, 255)
      nl.TextScaled = true
      nl.Font = Enum.Font.SourceSansBold

      local bg = Instance.new("Frame")
      bg.Parent = bb
      bg.Position = UDim2.new(0.1, 0, 0.5, 0)
      bg.Size = UDim2.new(0.8, 0, 0.3, 0)
      bg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
      bg.BorderSizePixel = 1

      local fill = Instance.new("Frame")
      fill.Parent = bg
      fill.Size = UDim2.new(0, 0, 1, 0)
      fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)

      bb.Parent = head
   end

   local function ApplyToolHoldPose(clone)
      local hum = clone:FindFirstChildOfClass("Humanoid")
      if not hum then return end
      for _, t in pairs(hum:GetPlayingAnimationTracks()) do t:Stop() end

      if hum.RigType == Enum.HumanoidRigType.R6 then
         local t = clone:FindFirstChild("Torso")
         if t then
            if t:FindFirstChild("Right Shoulder") then
               t["Right Shoulder"].C0 = CFrame.new(1.2, 0.6, -0.5) * CFrame.Angles(math.rad(85), math.rad(-35), math.rad(45))
            end
            if t:FindFirstChild("Left Shoulder") then
               t["Left Shoulder"].C0 = CFrame.new(-1.2, 0.6, -0.5) * CFrame.Angles(math.rad(85), math.rad(35), math.rad(-45))
            end
         end
      else
         local ru = clone:FindFirstChild("RightUpperArm")
         local lu = clone:FindFirstChild("LeftUpperArm")
         local rl = clone:FindFirstChild("RightLowerArm")
         local ll = clone:FindFirstChild("LeftLowerArm")
         if ru and ru:FindFirstChild("RightShoulder") then
            ru.RightShoulder.C0 = CFrame.new(1.1, 0.5, -0.3) * CFrame.Angles(math.rad(75), math.rad(-25), math.rad(30))
         end
         if lu and lu:FindFirstChild("LeftShoulder") then
            lu.LeftShoulder.C0 = CFrame.new(-1.1, 0.5, -0.3) * CFrame.Angles(math.rad(75), math.rad(25), math.rad(-30))
         end
         if rl and rl:FindFirstChild("RightElbow") then
            rl.RightElbow.C0 = CFrame.new(0, -0.2, 0) * CFrame.Angles(math.rad(-60), math.rad(-20), 0)
         end
         if ll and ll:FindFirstChild("LeftElbow") then
            ll.LeftElbow.C0 = CFrame.new(0, -0.2, 0) * CFrame.Angles(math.rad(-60), math.rad(20), 0)
         end
      end
   end

   Tool.Activated:Connect(function()
      if Cooldown then return end

      local MyChar = LocalPlayer.Character
      local MyRoot = MyChar and MyChar:FindFirstChild("HumanoidRootPart")
      local MyHum = MyChar and MyChar:FindFirstChildOfClass("Humanoid")
      if not MyRoot or not MyHum then return end

      local TargetPlayer = nil
      local ShortestDist = 18

      for _, p in pairs(Players:GetPlayers()) do
         if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") then
            if p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
               local d = (p.Character.HumanoidRootPart.Position - MyRoot.Position).Magnitude
               if d < ShortestDist then
                  ShortestDist = d
                  TargetPlayer = p
               end
            end
         end
      end

      if not TargetPlayer then return end
      Cooldown = true

      local TargetChar = TargetPlayer.Character
      local TargetRoot = TargetChar:FindFirstChild("HumanoidRootPart")
      local TargetHum = TargetChar:FindFirstChildOfClass("Humanoid")
      
      -- NAIKKAN POSISI +1.5 STUDS KE ATAS LANTAI (Anti Masuk Tanah)
      local StartCFrame = MyRoot.CFrame * CFrame.new(0, 1.5, 0)

      -- 1. Self Clone Visual
      MyChar.Archivable = true
      local SelfClone = MyChar:Clone()
      MyChar.Archivable = false

      for _, v in pairs(SelfClone:GetDescendants()) do
         if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") then v:Destroy() end
      end

      SelfClone.Name = "SelfClone_Visual"
      SelfClone.Parent = workspace
      SelfClone:SetPrimaryPartCFrame(StartCFrame)
      ApplyToolHoldPose(SelfClone)

      for _, part in pairs(SelfClone:GetDescendants()) do
         if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = true
         end
      end

      Camera.CameraSubject = SelfClone:FindFirstChildOfClass("Humanoid") or SelfClone:FindFirstChild("Head")

      -- 2. Target Clone Visual
      TargetChar.Archivable = true
      local TargetClone = TargetChar:Clone()
      TargetChar.Archivable = false

      for _, v in pairs(TargetClone:GetDescendants()) do
         if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") then v:Destroy() end
      end

      TargetClone.Name = "TargetClone_Dead"
      TargetClone.Parent = workspace

      local tCloneHum = TargetClone:FindFirstChildOfClass("Humanoid")
      if tCloneHum then
         tCloneHum.Health = 0
         tCloneHum.PlatformStand = true
         tCloneHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
      end

      if TargetClone:FindFirstChild("Head") then
         CreateDeadHealthbar(TargetClone.Head, TargetPlayer.Name)
      end

      local tCloneRoot = TargetClone:FindFirstChild("HumanoidRootPart") or TargetClone:FindFirstChild("Torso")
      if tCloneRoot then
         tCloneRoot.CanCollide = false
         tCloneRoot.Anchored = true
         tCloneRoot.CFrame = SelfClone.PrimaryPart.CFrame * CFrame.new(0, 0.2, -1.3) * CFrame.Angles(0, math.rad(180), math.rad(75))
      end

      -- 3. Invisible Mode Avatar Asli & Target
      SetTransparency(MyChar, 1)
      SetTransparency(TargetChar, 1)

      -- 4. POWERFUL HIGH-VELOCITY FLING (Daya Dorong Ekstrem)
      local FlingLoop
      local angle = 0
      FlingLoop = RunService.Heartbeat:Connect(function()
         if TargetRoot and MyRoot and Cooldown and MyHum.Health > 0 then
            angle = angle + 90
            -- Pindahkan posisi fisik tepat melingkari target dengan rotasi masif
            MyRoot.CFrame = TargetRoot.CFrame * CFrame.Angles(0, math.rad(angle), 0) * CFrame.new(0, 0.2, 0)
            MyRoot.Velocity = Vector3.new(999999, 999999, 999999)
            MyRoot.RotVelocity = Vector3.new(999999, 999999, 999999)
         else
            FlingLoop:Disconnect()
         end
      end)

      local function Cleanup()
         if FlingLoop then FlingLoop:Disconnect() end
         if MyHum and MyHum.Parent then Camera.CameraSubject = MyHum end
         if SelfClone and SelfClone.PrimaryPart and MyRoot then
            MyRoot.CFrame = SelfClone.PrimaryPart.CFrame
            MyRoot.Velocity = Vector3.new(0,0,0)
            MyRoot.RotVelocity = Vector3.new(0,0,0)
         end

         SetTransparency(MyChar, 0)

         if SelfClone then SelfClone:Destroy() end
         if TargetClone then TargetClone:Destroy() end
         Cooldown = false
      end

      if TargetHum then
         local conn
         conn = TargetHum.Died:Connect(function()
            conn:Disconnect()
            Cleanup()
         end)
      end

      task.delay(5, function()
         if Cooldown then Cleanup() end
      end)
   end)

   Tool.Parent = LocalPlayer.Backpack
end

GetToolButton.MouseButton1Click:Connect(function()
   GiveGrabTool()
end)
