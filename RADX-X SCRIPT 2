-- AUTO UPDATE PLAYER LIST (Join/Leave)
local function updatePlayerList()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 20)
            btn.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
            btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            btn.TextColor3 = Color3.fromRGB(200, 200, 220)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 9
            btn.Parent = playerScroll

            btn.MouseButton1Click:Connect(function()
                selectedPlayer = p
                dropBtn.Text = "Target: " .. p.Name
                playerListFrame.Visible = false
            end)
        end
    end
    playerScroll.CanvasSize = UDim2.new(0, 0, 0, count * 20)
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(function(p)
    if selectedPlayer == p then
        selectedPlayer = nil
        dropBtn.Text = "Select Target: None"
        if viewingTarget then
