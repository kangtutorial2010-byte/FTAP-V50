-- EXTREME POWER FE BYPASS FLING
flingBtn.MouseButton1Click:Connect(function()
    if not selectedPlayer or not selectedPlayer.Character or isFlinging then return end
    local char = player.Character
    local targetChar = selectedPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

    if hrp and targetHrp then
        isFlinging = true
        local originCFrame = hrp.CFrame

        -- 1. Invisible Setup
        local savedTransparencies = {}
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then
                savedTransparencies[v] = v.Transparency
                v.Transparency = 1
            end
        end

        -- 2. Force Max Collision on HumanoidRootPart Only
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        hrp.CanCollide = true

        -- 3. Extreme Force Loop
        local startTime = tick()
        local connection

        connection = RunService.PostSimulation:Connect(function()
            if tick() - startTime > 2.5 or not targetHrp or not targetHrp.Parent or not hrp or not hrp.Parent then
                connection:Disconnect()

                -- Reset Velocities & Return to Origin
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = originCFrame

                -- Restore Transparencies
                for part, trans in pairs(savedTransparencies) do
                    if part and part.Parent then
                        part.Transparency = trans
                    end
                end
                isFlinging = false
            else
                -- High-Power Oscillating Teleport (Direct Physical Contact)
                local powerMult = 200000000 -- Extreme Power Injection
                local sideOffset = (tick() * 200) % 2 == 0 and 0.05 or -0.05
                
                hrp.CFrame = targetHrp.CFrame * CFrame.new(sideOffset, -0.1, sideOffset) * CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))
                
                -- Extreme Angular & Linear Velocity Transfer
                hrp.AssemblyLinearVelocity = Vector3.new(powerMult, powerMult, powerMult)
                hrp.AssemblyAngularVelocity = Vector3.new(powerMult, powerMult, powerMult)
            end
        end)
    end
end)

