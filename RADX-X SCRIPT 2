            viewBtn.Text = "View Target: OFF"
            viewBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            camera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end
    end
    updatePlayerList()
end)
