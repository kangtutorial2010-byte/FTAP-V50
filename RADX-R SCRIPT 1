local function round(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function outline(obj, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or C.blue
    s.Transparency = transparency or 0.25
    s.Thickness = 1
    s.Parent = obj
end

local function tween(obj, properties, duration)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out),
        properties
    )
    t:Play()
    return t
end

-- Sistem Dragging
local function draggable(object, handle)
    local dragging = false
    local startPosition
    local startPoint
    local activeTouch

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPosition = object.Position
            startPoint = input.Position
            if input.UserInputType == Enum.UserInputType.Touch then
                activeTouch = input
            end
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input == activeTouch then
            local delta = input.Position - startPoint
            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            activeTouch = nil
        end
    end)
end

