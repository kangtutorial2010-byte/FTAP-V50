    label.TextColor3 = C.white
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local desc = Instance.new("TextLabel")
    desc.Position = UDim2.fromOffset(13, 29)
    desc.Size = UDim2.new(1, -75, 0, 15)
    desc.BackgroundTransparency = 1
    desc.Text = description or "Visual interface demo"
    desc.TextColor3 = C.muted
    desc.TextSize = 10
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = row

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(42, 23)
    toggle.Position = UDim2.new(1, -54, 0.5, -11)
    toggle.BackgroundColor3 = Color3.fromRGB(38, 54, 79)
    toggle.Text = ""
    toggle.Parent = row
    round(toggle, 20)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(17, 17)
    dot.Position = UDim2.fromOffset(3, 3)
    dot.BackgroundColor3 = C.white
    dot.Parent = toggle
    round(dot, 20)

    local active = false

    toggle.MouseButton1Click:Connect(function()
        active = not active

        tween(toggle, {
            BackgroundColor3 = active and C.blue or Color3.fromRGB(38, 54, 79)
        })

        tween(dot, {
            Position = active and UDim2.fromOffset(22, 3) or UDim2.fromOffset(3, 3)
        })

        if callback then
            callback(active)
        end
    end)
end

